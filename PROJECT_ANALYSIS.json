  "workflowStages": {
    "stagingModel": "Multi-tier approval workflow",
    "stages": [
      {
        "name": "Stage 1 - Faculty Review",
        "status": "pending_faculty",
        "reviewer": "faculty (adviser)",
        "actions": ["approve → Stage 2", "reject → rejected", "revision → revision_required"],
        "decision": "Faculty adviser approves and assigns to Dean OR Program Chair for Stage 2",
        "routing": "Adviser selects targetUserId and targetRole (dean|program_chair)"
      },
      {
        "name": "Stage 2a - Dean Review",
        "status": "pending_dean",
        "reviewer": "dean",
        "actions": ["approve → pending_editor", "reject → rejected", "revision → pending_dean"],
        "decision": "Dean reviews for institutional compliance"
      },
      {
        "name": "Stage 2b - Program Chair Review",
        "status": "pending_program_chair",
        "reviewer": "program_chair",
        "actions": ["approve → pending_editor", "reject → rejected", "revision → pending_program_chair"],
        "decision": "Program Chair reviews for department-level oversight"
      },
      {
        "name": "Stage 3 - Editorial Review",
        "status": "pending_editor",
        "reviewer": "staff (research editor)",
        "actions": ["approve → pending_admin", "reject → rejected", "revision → routes back to Stage 2 or 1"],
        "decision": "Staff editor conducts final content review"
      },
      {
        "name": "Stage 4 - Admin Final Approval",
        "status": "pending_admin",
        "reviewer": "admin",
        "actions": ["approve → approved (published)", "reject → rejected", "revision → pending_editor"],
        "decision": "Admin provides final authorization for publication"
      }
    ],
    "specialTransitions": [
      {
        "name": "Dean Bypass",
        "trigger": "Dean can bypass multiple stages",
        "requiredRole": "dean",
        "validTargets": ["pending_dean", "pending_editor", "pending_admin", "approved"],
        "blockedStatuses": ["approved", "published", "rejected"],
        "purpose": "Emergency expedited approval with audit trail"
      },
      {
        "name": "Revision Routing",
        "trigger": "Revision request from any stage",
        "behavior": "Returns to original submitter (student); restart from requesting stage",
        "tracking": "previous_status and last_reviewer_role used for routing"
      }
    ]
  },
