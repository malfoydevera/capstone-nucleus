{
  "projectMetadata": {
    "name": "Capstone Research Repository Management System",
    "version": "1.0.0",
    "description": "A sophisticated academic research repository management system with multi-stage approval workflows, AI-powered document analysis, and comprehensive role-based access control",
    "analysisDate": "2026-03-28",
    "status": "Production-Ready",
    "repositoryPath": "/Users/malfoyjamesdevera/CapstoneWeb/capstone-nucleus"
  },
  "systemOverview": {
    "purpose": "Manage research paper submissions through a complex multi-tier approval workflow with AI integration, secure document handling, and role-based access control",
    "keyFeatures": [
      "Multi-stage approval workflow (Student → Faculty → Dean/Program Chair → Staff → Admin)",
      "AI-powered document analysis using Google Gemini",
      "Secure PDF viewing with access control and watermarking",
      "Role-based access control (6 distinct user roles)",
      "Department and program management",
      "Audit logging and activity monitoring",
      "Annotation support for reviewers",
      "View and download analytics"
    ],
    "architecture": {
      "frontend": "React 19.2.0 SPA with Vite",
      "backend": "Node.js + Express 5.2.1 REST API",
      "database": "Supabase PostgreSQL with RLS",
      "storage": "Supabase Storage for PDF files",
      "aiIntegration": "Google Gemini AI API"
    }
  },
  "technologyStack": {
    "frontend": {
      "runtime": "Node.js (browser)",
      "framework": "React 19.2.0",
      "buildTool": "Vite 7.2.4",
      "routing": "React Router 7.11.0",
      "styling": "Tailwind CSS 4.1.18",
      "stateManagement": "React Context API",
      "ui": {
        "lucideReact": "0.562.0",
        "framerMotion": "12.33.0",
        "reactPDF": "10.3.0",
        "reactDropzone": "14.3.8",
        "reactHotToast": "2.6.0"
      },
      "http": "Axios 1.13.2",
      "authentication": "JWT tokens + Azure MSAL (optional)",
      "testing": {
        "vitest": "4.1.0",
        "testingLibraryReact": "16.3.2"
      }
    },
    "backend": {
      "runtime": "Node.js",
      "framework": "Express 5.2.1",
      "authentication": {
        "jwtLibrary": "jsonwebtoken 9.0.3",
        "passwordHash": "bcryptjs 3.0.3"
      },
      "fileHandling": "Multer 2.0.2",
      "pdf": "pdf-parse 1.1.1",
      "database": "@supabase/supabase-js 2.89.0",
      "storage": "@supabase/storage-js 2.89.0",
      "ai": "@google/generative-ai 0.24.1",
      "http": "Axios 1.13.2",
      "utilities": {
        "uuid": "13.0.0",
        "cors": "2.8.5",
        "dotenv": "17.2.3"
      },
      "testing": {
        "jest": "30.0.5",
        "supertest": "7.1.1",
        "nodemon": "3.1.11 (dev)"
      }
    },
    "external": {
      "database": "Supabase PostgreSQL",
      "storage": "Supabase Storage",
      "ai": "Google Gemini AI",
      "authentication": "Azure MSAL (optional)"
    }
  },
  "databaseSchema": {
    "tables": {
      "users": {
        "description": "Central authentication and identity table for all system users",
        "fields": {
          "id": "UUID primary key",
          "email": "VARCHAR unique, not null",
          "password": "VARCHAR bcrypt hash (cost 10)",
          "full_name": "VARCHAR not null",
          "role": "VARCHAR - student|faculty|dean|program_chair|staff|admin",
          "profile_picture_url": "TEXT optional",
          "bio": "TEXT optional",
          "program": "VARCHAR - student's academic program",
          "department": "VARCHAR - faculty/dean/chair department affiliation",
          "department_id": "UUID optional - links to departments table",
          "program_id": "UUID optional - links to programs table",
          "created_at": "TIMESTAMPTZ",
          "updated_at": "TIMESTAMPTZ"
        },
        "purpose": "Store all user accounts; JWT tokens issued by Express backend"
      },
      "research_papers": {
        "description": "Core table for research paper submissions tracked through approval workflow",
        "fields": {
          "id": "UUID primary key",
          "title": "VARCHAR not null",
          "abstract": "TEXT not null",
          "keywords": "TEXT[] - array of keyword strings",
          "author_id": "UUID FK to users (primary submitter)",
          "co_authors": "TEXT - legacy plain text field",
          "category": "VARCHAR not null",
          "file_url": "TEXT - Supabase Storage URL",
          "file_name": "VARCHAR",
          "file_size": "BIGINT - bytes",
          "file_storage_path": "TEXT - internal storage path for signed URLs",
          "status": "VARCHAR - see workflow statuses below",
          "submission_date": "TIMESTAMPTZ",
          "published_date": "TIMESTAMPTZ",
          "rejection_reason": "TEXT - set on reject",
          "revision_notes": "TEXT - feedback from reviewer",
          "view_count": "INTEGER",
          "download_count": "INTEGER",
          "faculty_id": "UUID FK - assigned adviser (Stage 1 reviewer)",
          "dean_chair_id": "UUID FK - Dean or Program Chair (Stage 2 reviewer)",
          "department": "VARCHAR",
          "department_id": "UUID FK to departments",
          "last_reviewer_role": "VARCHAR - role of last person who acted",
          "previous_status": "VARCHAR - status before revision",
          "bypass_reason": "TEXT - reason for dean bypass",
          "bypassed_by": "UUID - dean who did bypass",
          "bypassed_at": "TIMESTAMPTZ",
          "created_at": "TIMESTAMPTZ",
          "updated_at": "TIMESTAMPTZ"
        },
        "workflowStatuses": [
          "pending - legacy",
          "pending_faculty - Stage 1: awaiting adviser review",
          "pending_dean - Stage 2a: assigned to dean",
          "pending_program_chair - Stage 2b: assigned to program chair",
          "pending_editor - Stage 3: awaiting staff/editor review",
          "pending_admin - Stage 4: awaiting admin final approval",
          "revision_required - returned to student from any stage",
          "rejected - permanently rejected",
          "approved - final approval granted",
          "published - alternative final state",
          "under_review - legacy generic status",
          "faculty_approved - legacy intermediate",
          "editor_approved - legacy intermediate"
        ]
      },
      "research_authors": {
        "description": "Structured co-author join table",
        "fields": {
          "id": "UUID primary key",
          "research_id": "UUID FK to research_papers",
          "user_id": "UUID FK to users",
          "author_order": "INTEGER - 1=first, 2=second, etc",
          "is_primary": "BOOLEAN - true for main submitting author",
          "created_at": "TIMESTAMPTZ"
        }
      },
      "research_categories": {
        "description": "Lookup table for paper categories",
        "fields": {
          "id": "UUID",
          "name": "VARCHAR unique",
          "description": "TEXT",
          "created_at": "TIMESTAMPTZ"
        }
      },
      "approval_workflow": {
        "description": "Full audit trail of every review action",
        "fields": {
          "id": "UUID",
          "research_id": "UUID FK",
          "reviewer_id": "UUID FK to users",
          "reviewer_role": "VARCHAR - faculty|dean|program_chair|staff|admin",
          "status": "VARCHAR - approved|rejected|revision_required|bypassed|returned",
          "comments": "TEXT",
          "previous_status": "VARCHAR",
          "new_status": "VARCHAR",
          "action_type": "VARCHAR - review_action|etc",
          "metadata": "JSONB optional",
          "reviewed_at": "TIMESTAMPTZ",
          "created_at": "TIMESTAMPTZ"
        }
      },
      "faculty_reviews": {
        "description": "Adviser (faculty) review decisions on papers",
        "fields": {
          "id": "UUID",
          "research_id": "UUID FK",
          "faculty_id": "UUID FK",
          "status": "VARCHAR - approved|rejected|revision_required",
          "comments": "TEXT",
          "reviewed_at": "TIMESTAMPTZ"
        }
      },
      "research_comments": {
        "description": "Comment threads on papers",
        "fields": {
          "id": "UUID",
          "research_id": "UUID FK",
          "user_id": "UUID FK",
          "comment": "TEXT not null",
          "is_internal": "BOOLEAN - true=reviewers only, false=public",
          "created_at": "TIMESTAMPTZ",
          "updated_at": "TIMESTAMPTZ"
        }
      },
      "notifications": {
        "description": "In-app notification feed for users",
        "fields": {
          "id": "UUID",
          "user_id": "UUID FK to users",
          "research_id": "UUID FK optional",
          "type": "VARCHAR - approval|revision_required|review_request|etc",
          "title": "VARCHAR",
          "message": "TEXT",
          "is_read": "BOOLEAN default false",
          "created_at": "TIMESTAMPTZ"
        }
      },
      "paper_views": {
        "description": "View analytics per paper per user",
        "fields": {
          "id": "UUID",
          "research_id": "UUID FK",
          "user_id": "UUID FK",
          "viewed_at": "TIMESTAMPTZ"
        }
      },
      "paper_downloads": {
        "description": "Download analytics per paper per user",
        "fields": {
          "id": "UUID",
          "research_id": "UUID FK",
          "user_id": "UUID FK",
          "downloaded_at": "TIMESTAMPTZ"
        }
      },
      "audit_logs": {
        "description": "System-wide audit trail for compliance",
        "fields": {
          "id": "UUID",
          "user_id": "UUID FK",
          "user_role": "VARCHAR",
          "action": "VARCHAR - approve|reject|revision|bypass|etc",
          "target_type": "VARCHAR - research_paper|user|department|etc",
          "target_id": "UUID",
          "details": "JSONB",
          "created_at": "TIMESTAMPTZ"
        }
      },
      "departments": {
        "description": "Academic departments",
        "fields": {
          "id": "UUID",
          "name": "VARCHAR unique",
          "code": "VARCHAR",
          "description": "TEXT",
          "is_active": "BOOLEAN default true",
          "created_at": "TIMESTAMPTZ",
          "updated_at": "TIMESTAMPTZ"
        }
      },
      "programs": {
        "description": "Academic programs within departments",
        "fields": {
          "id": "UUID",
          "department_id": "UUID FK to departments",
          "name": "VARCHAR not null",
          "code": "VARCHAR",
          "description": "TEXT",
          "is_active": "BOOLEAN default true",
          "created_at": "TIMESTAMPTZ",
          "updated_at": "TIMESTAMPTZ"
        }
      }
    }
  },
  "apiEndpoints": {
    "auth": {
      "base": "/api/auth",
      "endpoints": [
        {
          "method": "POST",
          "path": "/register",
          "description": "Register new user (students and faculty only self-register)",
          "auth": "None",
          "requestBody": {
            "email": "string",
            "password": "string",
            "fullName": "string",
            "role": "string - student|faculty",
            "program": "string optional",
            "programId": "uuid optional",
            "department": "string optional",
            "departmentId": "uuid optional"
          },
          "responseBody": {
            "message": "string",
            "token": "jwt",
            "user": { "id": "uuid", "email": "string", "fullName": "string", "role": "string" }
          }
        },
        {
          "method": "POST",
          "path": "/login",
          "description": "Login user with email and password",
          "auth": "None",
          "requestBody": { "email": "string", "password": "string" },
          "responseBody": {
            "message": "string",
            "token": "jwt",
            "user": { "id": "uuid", "email": "string", "fullName": "string", "role": "string" }
          }
        },
        {
          "method": "GET",
          "path": "/me",
          "description": "Get current authenticated user",
          "auth": "JWT Required",
          "responseBody": { "user": { "id": "uuid", "email": "string", "fullName": "string", "role": "string", "createdAt": "timestamp" } }
        },
        {
          "method": "GET",
          "path": "/student/search",
          "description": "Search students for co-author selection",
          "auth": "JWT Required",
          "queryParams": { "query": "string" }
        },
        {
          "method": "GET",
          "path": "/users",
          "description": "List all users",
          "auth": "JWT Required - Admin only",
          "queryParams": { "role": "string optional" }
        },
        {
          "method": "DELETE",
          "path": "/users/:id",
          "description": "Delete user",
          "auth": "JWT Required - Admin only"
        },
        {
          "method": "POST",
          "path": "/users/create",
          "description": "Create privileged account (faculty, staff, dean, program_chair, admin)",
          "auth": "JWT Required - Admin only",
          "requestBody": {
            "email": "string",
            "password": "string",
            "fullName": "string",
            "role": "string - faculty|staff|dean|program_chair|admin",
            "department": "string optional"
          }
        }
      ]
    },
    "research": {
      "base": "/api/research",
      "endpoints": [
        {
          "method": "GET",
          "path": "/published",
          "description": "Get published/approved research papers (public endpoint)",
          "auth": "None",
          "queryParams": { "category": "string", "search": "string", "limit": "integer", "offset": "integer" }
        },
        {
          "method": "GET",
          "path": "/categories",
          "description": "Get all research categories",
          "auth": "None"
        },
        {
          "method": "POST",
          "path": "/submit",
          "description": "Submit new research or update revision",
          "auth": "JWT Required - student|staff|admin",
          "requestBody": {
            "id": "uuid optional - for updates",
            "title": "string",
            "abstract": "string",
            "keywords": "string comma-separated",
            "coAuthors": "string optional",
            "coAuthorIds": "uuid[] optional",
            "category": "string",
            "facultyId": "uuid optional - adviser to assign",
            "department": "string optional",
            "departmentId": "uuid optional",
            "file": "file - PDF required for new submissions"
          }
        },
        {
          "method": "GET",
          "path": "/my/papers",
          "description": "Get current user's research papers",
          "auth": "JWT Required"
        },
        {
          "method": "GET",
          "path": "/all/papers",
          "description": "Get all research papers",
          "auth": "JWT Required - staff|admin",
          "queryParams": { "status": "string optional" }
        },
        {
          "method": "GET",
          "path": "/:id",
          "description": "Get research paper by ID",
          "auth": "JWT Required",
          "accessControl": "Author, reviewer, staff, or admin"
        },
        {
          "method": "GET",
          "path": "/:id/file",
          "description": "Get research paper file with access control",
          "auth": "JWT Required"
        },
        {
          "method": "POST",
          "path": "/:id/view",
          "description": "Track paper view",
          "auth": "JWT Required"
        },
        {
          "method": "POST",
          "path": "/:id/download",
          "description": "Track paper download",
          "auth": "JWT Required"
        },
        {
          "method": "GET",
          "path": "/profile/data",
          "description": "Get profile research data",
          "auth": "JWT Required"
        },
        {
          "method": "POST",
          "path": "/:id/approve",
          "description": "Approve research paper",
          "auth": "JWT Required - faculty|dean|program_chair|staff|admin",
          "requestBody": {
            "comments": "string optional",
            "targetUserId": "uuid - for faculty approving to dean/chair",
            "targetRole": "string - dean|program_chair"
          }
        },
        {
          "method": "POST",
          "path": "/:id/reject",
          "description": "Reject research paper",
          "auth": "JWT Required - faculty|dean|program_chair|staff|admin",
          "requestBody": { "reason": "string required" }
        },
        {
          "method": "POST",
          "path": "/:id/revision",
          "description": "Request revision on research paper",
          "auth": "JWT Required - faculty|dean|program_chair|staff|admin",
          "requestBody": { "notes": "string required" }
        },
        {
          "method": "POST",
          "path": "/:id/dean-bypass",
          "description": "Dean bypass approve paper",
          "auth": "JWT Required - dean",
          "requestBody": {
            "bypassReason": "string",
            "target": "string optional - approved|pending_editor|etc"
          }
        },
        {
          "method": "GET",
          "path": "/faculty/members",
          "description": "Get faculty members for paper assignment",
          "auth": "JWT Required",
          "queryParams": { "department": "string optional" }
        },
        {
          "method": "GET",
          "path": "/dean-chair/members",
          "description": "Get dean/program chair members",
          "auth": "JWT Required - faculty",
          "queryParams": { "department": "string optional", "includeDean": "boolean" }
        },
        {
          "method": "GET",
          "path": "/faculty/assigned",
          "description": "Get papers assigned to faculty reviewer",
          "auth": "JWT Required - faculty",
          "queryParams": { "status": "string optional" }
        },
        {
          "method": "GET",
          "path": "/dean-chair/assigned",
          "description": "Get papers assigned to dean/program chair",
          "auth": "JWT Required - dean|program_chair",
          "queryParams": { "status": "string optional" }
        },
        {
          "method": "GET",
          "path": "/dean/activity-monitor",
          "description": "Get dean activity monitoring data",
          "auth": "JWT Required - dean"
        },
        {
          "method": "GET",
          "path": "/dean/audit-logs",
          "description": "Get audit logs for dean oversight",
          "auth": "JWT Required - dean"
        },
        {
          "method": "GET",
          "path": "/:id/annotations",
          "description": "Get paper annotations",
          "auth": "JWT Required"
        },
        {
          "method": "POST",
          "path": "/:id/annotations",
          "description": "Add annotation to paper",
          "auth": "JWT Required - faculty|dean|program_chair|staff|admin",
          "requestBody": { "annotation": "object with text, location, etc" }
        },
        {
          "method": "DELETE",
          "path": "/:id/annotations/:annotationId",
          "description": "Delete annotation",
          "auth": "JWT Required - owner or admin"
        }
      ]
    },
    "ai": {
      "base": "/api/ai",
      "rateLimit": "30 requests per 60 seconds per user",
      "endpoints": [
        {
          "method": "POST",
          "path": "/chat",
          "description": "Chat with research paper using AI",
          "auth": "JWT Required",
          "requestBody": {
            "paperId": "uuid",
            "message": "string"
          },
          "responseBody": {
            "data": {
              "response": "string - AI generated response",
              "paperId": "uuid"
            }
          },
          "implementation": "Google Gemini API with PDF text extraction via pdf-parse"
        },
        {
          "method": "POST",
          "path": "/extract-pdf",
          "description": "Extract metadata from PDF file",
          "auth": "JWT Required",
          "requestBody": {
            "file": "file - PDF"
          }
        }
      ]
    },
    "departments": {
      "base": "/api/departments",
      "endpoints": [
        {
          "method": "GET",
          "path": "/",
          "description": "List all active departments with programs",
          "auth": "None"
        },
        {
          "method": "GET",
          "path": "/:id/programs",
          "description": "Get programs for a department",
          "auth": "None"
        },
        {
          "method": "POST",
          "path": "/",
          "description": "Create new department",
          "auth": "JWT Required - admin",
          "requestBody": {
            "name": "string",
            "code": "string",
            "description": "string"
          }
        },
        {
          "method": "PUT",
          "path": "/:id",
          "description": "Update department",
          "auth": "JWT Required - admin",
          "requestBody": {
            "name": "string optional",
            "code": "string optional",
            "description": "string optional",
            "is_active": "boolean optional"
          }
        },
        {
          "method": "DELETE",
          "path": "/:id",
          "description": "Soft-delete department (sets is_active=false)",
          "auth": "JWT Required - admin"
        },
        {
          "method": "POST",
          "path": "/:id/programs",
          "description": "Create program under department",
          "auth": "JWT Required - admin",
          "requestBody": {
            "name": "string",
            "code": "string",
            "description": "string"
          }
        },
        {
          "method": "PUT",
          "path": "/programs/:programId",
          "description": "Update program",
          "auth": "JWT Required - admin",
          "requestBody": {
            "name": "string optional",
            "code": "string optional",
            "description": "string optional",
            "is_active": "boolean optional"
          }
        },
        {
          "method": "DELETE",
          "path": "/programs/:programId",
          "description": "Soft-delete program",
          "auth": "JWT Required - admin"
        }
      ]
    }
  },
